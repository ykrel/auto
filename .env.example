# Yonetici paneli sifresi (zorunlu)
ADMIN_PASSWORD=degistir-beni

# QR iceriginde kullanilacak genel adres (sonunda / olmadan)
BASE_URL=https://pdks.orneksirket.com

# Railway PORT'u kendisi verir; yerelde 3000 kullanilir
PORT=3000

# SQLite dosyasinin tutulacagi klasor (Railway'de volume mount yolu)
DATA_DIR=/data

# Opsiyonel: admin session imzalama anahtari (verilmezse ADMIN_PASSWORD'dan turetilir)
# SESSION_SECRET=uzun-rastgele-bir-dize

# Opsiyonel: gec giris toleransi (dk), mesai bitisi ve erken cikis bildirimi toleransi (dk)
# LATE_TOLERANCE_MIN=10
# SHIFT_END=18:30
# SHIFT_END_SAT=17:00
# EARLY_EXIT_TOLERANCE_MIN=5
